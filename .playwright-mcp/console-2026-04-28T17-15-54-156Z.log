                  // 全局点击事件监听
                  document.addEventListener('click', function(e) {
                    // 只处理a标签的点击
                    const anchor = e.target.closest('a');
                    if (!anchor) return;
                    
                    const href = anchor.getAttribute('href');
                    // 只处理相对路径的链接
                    if (!href || href.startsWith('http') || href.startsWith('#')) return;
                    
                    // 阻止默认行为
                    e.preventDefault();
                    
                    let newPath = '';
                    // 处理特殊路径转换规则
