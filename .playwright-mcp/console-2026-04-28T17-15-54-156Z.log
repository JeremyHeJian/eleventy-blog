                      newPath = prefix + path + '.html';
                    } else {
                      newPath = prefix + '/' + path + '.html';
                    }

                    if (query) {
                      newPath += '?' + query;
                    }
                    
                    // 跳转到新路径
                    window.location.href = newPath;
                  });
                }
