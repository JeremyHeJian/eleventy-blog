---
layout: layouts/base.njk
---
<article class="prose dark:prose-invert max-w-3xl mx-auto">
  <h1 class="text-4xl font-bold mb-2">{{ title }}</h1>
  <div class="flex items-center space-x-4 text-sm mb-8">
    <time datetime="{{ pubDate | isoDate }}" class="text-sm text-gray-500 dark:text-gray-400">
      {{ pubDate | formatDate }}
    </time>
    <div class="flex space-x-2">
      {% for tag in tags %}
      <a
        href="/tags/{{ tag | slugify }}/"
        class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-full text-sm hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
      >
        {{ tag }}
      </a>
      {% endfor %}
    </div>
  </div>
  {{ content | safe }}
</article>
