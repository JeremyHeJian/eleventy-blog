---
layout: layouts/base.njk
title: Home
---
<h1 class="text-4xl font-bold mb-8">Latest Posts</h1>

<div class="space-y-8">
  {% for post in collections.blogpost %}
  <article class="border-b border-gray-200 dark:border-gray-700 pb-8">
    <h2 class="text-2xl font-bold mb-2">
      <a href="{{ post.url }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        {{ post.data.title }}
      </a>
    </h2>
    <div class="flex items-center space-x-2 text-sm mb-2">
      <time datetime="{{ post.data.pubDate | isoDate }}" class="text-sm text-gray-500 dark:text-gray-400">
        {{ post.data.pubDate | formatDate }}
      </time>
      <span>•</span>
      <span>{% for tag in post.data.tags %}#{{ tag }}{% if not loop.last %} {% endif %}{% endfor %}</span>
    </div>
    <p class="text-gray-600 dark:text-gray-300">{{ post.data.description }}</p>
  </article>
  {% endfor %}
</div>
